# Local development configuration.
# For a VPS or production deployment, use .env.production.example instead.

# PostgreSQL connection. The local Docker Compose database listens on 5434.
DATABASE_URL=postgresql://hub:hub@localhost:5434/hub

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional database pool size (default: 10).
# DATABASE_POOL_MAX=10

# Optional comma-separated extra trusted origins.
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.example.com

# Optional transactional email (invitations + in-app notification emails).
# Leave SMTP_HOST empty to keep email delivery disabled; invite links still work.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Hub <notifications@example.com>"
# SMTP_REPLY_TO=support@example.com
# Default email notification types. Add task_updated for every followed-task update.
EMAIL_NOTIFICATION_TYPES=assigned,mentioned,comment
