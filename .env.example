# Local development configuration.
# For a VPS or production deployment, use .env.production.example instead.

# PostgreSQL connection. The local Docker Compose database listens on 5434.
DATABASE_URL=postgresql://hub:hub@localhost:5434/hub

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional database pool size (default: 10).
# DATABASE_POOL_MAX=10

# Optional comma-separated extra trusted origins.
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.example.com
