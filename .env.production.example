# ─────────────────────────────────────────────────────────────────────────────
# Hub production configuration
#
#   1. cp .env.production.example .env
#   2. Fill in every required value.
#   3. docker compose -f docker-compose.prod.yml up -d --build
#
# Never commit the resulting .env file.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app. Include https:// and do not add a trailing slash.
BETTER_AUTH_URL=https://hub.example.com

# Domain only (no scheme, no path). Used by the optional Caddy HTTPS proxy.
APP_DOMAIN=hub.example.com

# Generate both secrets with:
#   openssl rand -base64 32   # BETTER_AUTH_SECRET
#   openssl rand -hex 24      # POSTGRES_PASSWORD (safe inside connection strings)
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Defaults are fine for a single Hub instance.
POSTGRES_USER=hub
POSTGRES_DB=hub
APP_PORT=3000
DATABASE_POOL_MAX=10

# Optional comma-separated extra origins (for example https://www.example.com).
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.example.com

# ── Transactional email (optional) ──────────────────────────────────────────
# Leave SMTP_HOST and SMTP_FROM empty to disable email delivery. Invitations
# still produce copyable links and in-app notifications continue to work.
# When enabled, invitations are emailed immediately and notification emails
# are delivered by the in-process outbox worker.
#
# Example:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=...
# SMTP_FROM="Hub <notifications@yourdomain.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_REPLY_TO=support@yourdomain.com
# Default: assigned,mentioned,comment. Add task_updated if every followed-task
# update should also send an email.
EMAIL_NOTIFICATION_TYPES=assigned,mentioned,comment
